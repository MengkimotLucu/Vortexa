---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.astro';
import Footer from '../components/Footer.astro';

const isEn = Astro.currentLocale === 'en';
const title = isEn ? 'Web Design Portfolio & Case Studies | LUMOVELO' : 'Studi Kasus & Portofolio Karya | LUMOVELO';
const description = isEn
  ? 'Explore Lumovelo website development, e-commerce, POS, and UI/UX projects built for responsive performance, usability, and business growth.'
  : 'Lihat hasil karya pengembangan website berkinerja tinggi, dasbor UI/UX modern, dan hasil optimasi SEO nyata dari proyek klien LUMOVELO.';
---

<Layout title={title} description={description}>
  <main class="relative z-10">
    <Portfolio />
  </main>

  <Footer />
</Layout>
