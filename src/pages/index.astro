---
import Layout from '../layouts/Layout.astro';
import HomeReferenceStyle from '../components/HomeReferenceStyle.astro';

const lang = Astro.currentLocale === 'en' ? 'en' : 'id';

const meta = {
  id: {
     title: "Solusi Digital untuk Bisnis yang Bertumbuh | Lumovelo",
     description: "Lumovelo membantu bisnis, UMKM, startup, dan perusahaan membangun website profesional yang cepat, responsif, SEO-friendly, dan siap menghasilkan pelanggan."
  },
  en: {
     title: "Professional Website Development from $70 | Lumovelo",
     description: "Fast, professional, SEO-ready websites for businesses and startups. Get a conversion-focused website with clear pricing and direct collaboration."
  }
}[lang];

const pageUrl = lang === 'en' ? 'https://www.lumovelo.com/en/' : 'https://www.lumovelo.com/';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.lumovelo.com/#website",
  "name": "LUMOVELO",
  "url": "https://www.lumovelo.com",
  "inLanguage": ["id-ID", "en-US"],
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": meta.title,
  "description": meta.description,
  "inLanguage": lang === 'en' ? "en-US" : "id-ID",
  "isPartOf": { "@id": "https://www.lumovelo.com/#website" },
  "about": { "@id": "https://www.lumovelo.com/#organization" },
};
---

<Layout title={meta.title} description={meta.description} schema={[websiteSchema, webPageSchema]}>

  <HomeReferenceStyle />
</Layout>
