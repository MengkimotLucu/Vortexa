---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Blog from '../../components/Blog.astro';
import Footer from '../../components/Footer.astro';

const isEn = Astro.currentLocale === 'en';
const pageTitle = isEn ? 'Technology, SEO & AI Insights | LUMOVELO' : 'Wawasan, Edukasi & Artikel Teknologi | LUMOVELO';
const pageDescription = isEn
  ? 'Practical articles about technical SEO, high-performance websites, AI automation, and conversion-focused digital growth.'
  : 'Baca artikel praktis tentang technical SEO, website berkinerja tinggi, otomatisasi AI, dan strategi pertumbuhan digital.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="relative z-10">
    <Blog />
  </main>

  <Footer />
</Layout>
