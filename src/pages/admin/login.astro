---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { DemoAiAssistatBasic } from '../../components/ui/demo';
---

<Layout title="Login Admin | LUMOVELO" description="Akses masuk aman ke Dashboard Admin Lumovelo." noindex={true}>
  <div class="min-h-screen bg-slate-50 flex items-center justify-center font-sans">
    <div id="admin-login-root" class="relative w-full">
      <div class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center p-6" aria-hidden="true">
        <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl">
          <p class="text-xs font-mono font-bold uppercase tracking-widest text-blue-600">LUMOVELO ADMIN</p>
          <p class="mt-3 text-sm font-semibold text-slate-600">Memuat halaman login aman...</p>
        </div>
      </div>
      <div class="relative z-10">
        <DemoAiAssistatBasic client:load />
      </div>
      <noscript>
        <div class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl">
          <h1 class="text-xl font-bold text-slate-900">JavaScript diperlukan</h1>
          <p class="mt-2 text-sm text-slate-600">Aktifkan JavaScript untuk membuka halaman login admin.</p>
        </div>
      </noscript>
    </div>
  </div>
</Layout>
