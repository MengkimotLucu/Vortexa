---
import Layout from '../layouts/Layout.astro';
import Karir from '../components/Karir.astro';
import Footer from '../components/Footer.astro';

const isEn = Astro.currentLocale === 'en';
const title = isEn ? 'Remote Careers & Collaboration | LUMOVELO' : 'Karir & Kolaborasi | LUMOVELO';
const description = isEn
  ? 'Explore remote career and project collaboration opportunities with Lumovelo across web development, SEO, design, quality assurance, and AI.'
  : 'Gabung bersama LUMOVELO. Kami membuka kesempatan kolaborasi bagi para profesional berbakat untuk bergabung dalam proyek-proyek teknologi tinggi.';
---

<Layout title={title} description={description}>
  <main class="relative z-10">
    <Karir />
  </main>

  <Footer />
</Layout>
