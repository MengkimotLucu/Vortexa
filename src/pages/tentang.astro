---
import Layout from "../layouts/Layout.astro";
import AboutReferenceStyle from "../components/AboutReferenceStyle.astro";

const isEn = Astro.currentLocale === "en";
const title = isEn
  ? "About Lumovelo | Web Development, SEO & AI Studio"
  : "Tentang Lumovelo | Studio Website, SEO & AI Indonesia";
const description = isEn
  ? "Meet Lumovelo, an Indonesian digital studio helping businesses build professional websites, SEO foundations, web applications, and practical AI solutions."
  : "Kenali Lumovelo, studio digital Indonesia yang membantu bisnis membangun website profesional, fondasi SEO, web application, dan solusi AI melalui kolaborasi langsung.";
---

<Layout title={title} description={description}>
  <AboutReferenceStyle />
</Layout>
