---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const sections = [
  ["1. Information We Collect", "We collect information you voluntarily provide through interactive forms, such as your name, business name, selected service, and estimated budget. This information is sent directly to our official WhatsApp or email contact."],
  ["2. Website Data Storage", "Our lightweight headless and serverless website does not store form submissions in a traditional website database. Submitted information is transmitted to our official communication channels so we can respond to your enquiry."],
  ["3. How We Use Information", "We use submitted information only to respond to project enquiries, prepare a suitable project plan and estimate, and follow up about relevant Lumovelo services."],
  ["4. Information Security", "We take reasonable measures to protect your information and use established third-party communication services. Please avoid sending sensitive credentials or confidential access data through public website forms."],
  ["5. Policy Updates", "Lumovelo may update this Privacy Policy when our services or data practices change. The latest revision date will always appear on this page."],
];
---

<Layout title="Privacy Policy | LUMOVELO" description="Read the Lumovelo Privacy Policy to understand what information we collect through our website, how it is used, and how we protect enquiries.">
  <main class="min-h-screen bg-slate-50 py-16 md:py-24">
    <article class="mx-auto max-w-3xl px-6">
      <p class="text-xs font-bold uppercase text-slate-500">Last updated: June 18, 2026</p>
      <h1 class="mt-4 text-3xl font-black uppercase leading-tight text-slate-900 sm:text-4xl md:text-5xl">Privacy Policy</h1>
      <div class="mt-6 h-1 w-full rounded-full bg-blue-600/30"></div>
      <div class="mt-8 space-y-6 text-sm font-semibold leading-relaxed text-slate-700 sm:text-base">
        <p>Lumovelo respects the privacy of website visitors and clients. This policy explains how we handle information submitted through this website.</p>
        {sections.map(([heading, body]) => (
          <section>
            <h2 class="mt-8 text-xl font-bold uppercase text-slate-900">{heading}</h2>
            <p class="mt-4">{body}</p>
          </section>
        ))}
      </div>
    </article>
  </main>
  <Footer />
</Layout>
