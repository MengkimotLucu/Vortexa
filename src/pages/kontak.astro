---
import Layout from '../layouts/Layout.astro';
import Kontak from '../components/Kontak.astro';
import Footer from '../components/Footer.astro';

const lang = Astro.currentLocale === 'en' ? 'en' : 'id';

const meta = {
  id: {
    title: "Hubungi Kami & Konsultasi Proyek Gratis | LUMOVELO",
    description: "Hubungi tim Lumovelo untuk jasa website bandung, jakarta, dan seluruh Indonesia. Kolaborasi pembuatan website kustom, otomatisasi AI, dan jasa SEO terbaik.",
    backBtn: "Kembali Ke Beranda"
  },
  en: {
    title: "Contact Us & Free Project Consultation | LUMOVELO",
    description: "Contact the Lumovelo team to start a collaboration on custom website development, AI automation, and SEO services in Bandung, West Java, Indonesia.",
    backBtn: "Back to Home"
  }
}[lang];
---

<Layout title={meta.title} description={meta.description}>
  <main class="relative z-10">
    <Kontak />
  </main>

  <Footer />
</Layout>
