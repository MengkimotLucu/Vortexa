---
const lang = Astro.currentLocale === "en" ? "en" : "id";

const content = {
  id: {
    sectionHeader: "Tentang Kami",
    title1: "Kolaborasi Digital.",
    title2: "Tumbuh Bersama Anda.",
    desc1:
      "LUMOVELO adalah studio digital yang saya jalankan langsung untuk membantu bisnis membangun kehadiran digital yang lebih jelas. Anda berkomunikasi langsung dengan pemilik, tanpa lapisan account manager yang tidak perlu.",
    desc2:
      "Kami percaya bahwa teknologi terbaik adalah teknologi yang memudahkan. Oleh karena itu, kami merancang website dengan pendekatan arsitektur modern yang ringan, mudah dikelola secara mandiri, serta dioptimalkan agar mudah ditemukan oleh calon pelanggan Anda di mesin pencari.",
    desc3:
      "Setiap proyek dikerjakan dengan scope, milestone, dan hasil yang disepakati sejak awal. Fokusnya bukan sekadar membuat website terlihat bagus, tetapi membangun aset digital yang mudah dipahami, mudah dikembangkan, dan siap membantu bisnis mendapatkan pelanggan.",
    cta: "Pelajari Cara Kerja Kami",
    visionHeader: "VISI KAMI",
    visionTitle: "Mendorong Inovasi Digital Tanpa Batas",
    visionDesc:
      "Menjadi mitra transformasi teknologi terdepan yang mendemokrasikan sistem kecerdasan buatan (AI) dan desain web kelas dunia untuk semua skala bisnis, mendorong pertumbuhan yang terukur, efisien, dan berkelanjutan.",
    missionHeader: "MISI KAMI",
    missionTitle: "Membangun Teknologi yang Memberdayakan",
    missionDesc:
      "Kami berdedikasi menciptakan website berkinerja tinggi, mengintegrasikan otomatisasi cerdas yang memotong biaya operasional, dan menghadirkan optimasi pencarian Google yang mendominasi pasar demi kesuksesan jangka panjang mitra kami.",
  },
  en: {
    sectionHeader: "About Us",
    title1: "Digital Collaboration.",
    title2: "Growing Together with You.",
    desc1:
      "LUMOVELO is an independent digital studio focused on simplifying your business's digital presence. You work directly with the person responsible for the design, development, and delivery of your project.",
    desc2:
      "We believe the best technology is technology that simplifies. Therefore, we design websites using a modern, lightweight, self-managed architectural approach, optimized to be easily discovered by your potential customers on search engines.",
    desc3:
      "Every project is handled with a clear scope, milestones, and agreed deliverables. The goal is not just a good-looking website, but a useful digital asset that is easier to understand, improve, and grow.",
    cta: "Learn How We Work",
    visionHeader: "OUR VISION",
    visionTitle: "Driving Limitless Digital Innovation",
    visionDesc:
      "To be the leading technology transformation partner that democratizes world-class AI systems and web design for all business sizes, driving measurable, efficient, and sustainable growth.",
    missionHeader: "OUR MISSION",
    missionTitle: "Building Technology that Empowers",
    missionDesc:
      "We are dedicated to creating high-performance websites, integrating smart automation that slashes operational costs, and delivering search-engine-dominant SEO strategies for our partners' long-term success.",
  },
}[lang];

const contactLink = lang === "en" ? "/en/#konsultasi" : "#konsultasi";
---

<section
  id="tentang-kami"
  class="py-24 bg-white relative overflow-hidden border-t-2 border-slate-100"
>
  <!-- Grid pattern overlay -->
  <div
    class="absolute inset-0 bg-[radial-gradient(#2563eb_0.5px,transparent_0.5px)] bg-[size:1.5rem_1.5rem] opacity-[0.03] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 reveal-on-scroll">
    <div class="max-w-3xl mx-auto text-justify space-y-8 mb-16">
      <div class="space-y-3">
        <h2
          class="font-mono font-bold text-xs tracking-widest text-blue-600 uppercase"
        >
          {content.sectionHeader}
        </h2>
        <h2
          class="font-display font-black text-4xl sm:text-5xl text-slate-900 uppercase tracking-tight leading-[1.1]"
        >
          {content.title1}<br />
          <span class="text-blue-600">{content.title2}</span>
        </h2>
      </div>

      <div
        class="space-y-6 text-slate-600 text-sm sm:text-base leading-relaxed font-medium"
      >
        <p class="font-semibold text-slate-800">
          {content.desc1}
        </p>

        <p>
          {content.desc2}
        </p>

        <p
            class="text-xs sm:text-[13px] text-slate-500 leading-relaxed font-normal"
        >
          {content.desc3}
        </p>
      </div>
    </div>

    <!-- Vision & Mission Section -->
    <div class="mt-20 pt-16 border-t border-slate-100">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Visi Card -->
        <div
          class="bg-slate-50 border border-slate-200/60 p-8 rounded-2xl relative overflow-hidden group hover:border-blue-500/30 transition-all duration-300"
        >
          <div
            class="absolute right-0 top-0 translate-x-4 -translate-y-4 w-24 h-24 bg-blue-500/[0.03] rounded-full blur-xl"
          >
          </div>
          <div
            class="w-10 h-10 rounded-xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center mb-4 text-blue-600 text-sm font-bold"
          >
            🎯
          </div>
          <h4
            class="text-xs font-black uppercase tracking-widest text-slate-400 mb-2"
          >
            {content.visionHeader}
          </h4>
          <h3 class="text-xl font-extrabold text-slate-900 mb-3">
            {content.visionTitle}
          </h3>
          <p
            class="text-slate-600 text-xs sm:text-[13px] leading-relaxed font-medium"
          >
            {content.visionDesc}
          </p>
        </div>

        <!-- Misi Card -->
        <div
          class="bg-slate-50 border border-slate-200/60 p-8 rounded-2xl relative overflow-hidden group hover:border-blue-500/30 transition-all duration-300"
        >
          <div
            class="absolute right-0 top-0 translate-x-4 -translate-y-4 w-24 h-24 bg-blue-500/[0.03] rounded-full blur-xl"
          >
          </div>
          <div
            class="w-10 h-10 rounded-xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center mb-4 text-blue-600 text-sm font-bold"
          >
            🚀
          </div>
          <h4
            class="text-xs font-black uppercase tracking-widest text-slate-400 mb-2"
          >
            {content.missionHeader}
          </h4>
          <h3 class="text-xl font-extrabold text-slate-900 mb-3">
            {content.missionTitle}
          </h3>
          <p
            class="text-slate-600 text-xs sm:text-[13px] leading-relaxed font-medium"
          >
            {content.missionDesc}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
