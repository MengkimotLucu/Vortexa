  {
    id: 'fullstack-developer',
    division: 'Software Engineering',
    title: 'Full-Stack Developer',
    accent: '#b5e5ce',
    requirements: {
      id: [
        'Menguasai API pihak ketiga dan database PostgreSQL atau MongoDB.',
        'Berpengalaman dengan Node.js, Go, atau Python serta Docker.',
        'Cepat memahami dokumentasi dan mengimplementasikan integrasi.',
