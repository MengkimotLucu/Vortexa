  {
    id: 'uiux-designer',
    division: 'Product Design',
    title: 'UI/UX Designer',
    accent: '#f2b9df',
    requirements: {
      id: [
        'Mahir menggunakan Figma, prototyping, dan design system.',
        'Memiliki portofolio website, dashboard, atau produk digital.',
        'Memahami dasar HTML/CSS untuk kolaborasi dengan developer.',
      ],
      en: [
        'Proficient in Figma, prototyping, and design systems.',
        'Have a portfolio of websites, dashboards, or digital products.',
        'Understand basic HTML/CSS for smoother developer collaboration.',
      ],
