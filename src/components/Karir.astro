---
import { Image } from 'astro:assets';
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  BriefcaseBusiness,
  Check,
  Clock3,
  MapPin,
  MessageCircle,
  Sparkles,
} from 'lucide-react';
import careerHeroImg from '../assets/career-hero.webp';

const lang = Astro.currentLocale === 'en' ? 'en' : 'id';
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '6285624353611';

