      ],
      en: [
        'Proficient in Photoshop, Illustrator, Figma, or Canva Pro.',
        'Experienced in social content, carousels, and advertising assets.',
        'Understand composition, typography, color, and brand identity.',
      ],
    },
    noteLabel: { id: 'Tools & gaya visual utama', en: 'Primary tools and visual style' },
    notePlaceholder: { id: 'Contoh: Illustrator + Figma; brand identity dan campaign sosial...', en: 'Example: Illustrator + Figma; brand identity and social campaigns...' },
  },
  {
    id: 'qa-engineer',
    division: 'Quality Engineering',
    title: 'QA & Test Automation Engineer',
    accent: '#9de1dc',
    requirements: {
      id: [
        'Menguasai Cypress, Playwright, atau Appium.',
        'Memahami integrasi testing dalam pipeline CI/CD.',
        'Mampu menyusun test case dan melakukan load testing.',
      ],
