    title: 'Kerja hebat lahir dari kolaborasi yang sehat.',
    intro: 'Kami mempertemukan talenta yang tajam, rasa ingin tahu yang besar, dan proyek digital yang benar-benar perlu diselesaikan.',
    heroCta: 'Lihat posisi terbuka',
    remote: 'Remote dari Indonesia',
    model: 'Freelance & kontrak proyek',
    response: 'Seleksi langsung oleh tim',
    imageCaption: 'Bangun karya yang bisa dibanggakan, dari mana saja.',
    jobsKicker: 'Posisi terbuka',
    jobsTitle: 'Temukan ruang terbaik untuk keahlianmu.',
    jobsDesc: 'Pilih posisi, baca kualifikasinya, lalu kirim profil melalui WhatsApp dengan format yang sudah kami siapkan untuk tiap divisi.',
    type: 'Freelance / Kontrak',
    location: 'Remote',
    detail: 'Lihat kualifikasi',
    qualification: 'Yang kami cari',
    apply: 'Lamar posisi ini',
    processKicker: 'Cara bergabung',
    processTitle: 'Singkat, jelas, dan langsung dengan tim.',
    process: [
      ['01', 'Pilih divisi', 'Buka posisi yang paling dekat dengan pengalaman dan minatmu.'],
      ['02', 'Kirim profil', 'Lengkapi form singkat. Pesan WhatsApp akan diformat otomatis.'],
      ['03', 'Mulai percakapan', 'Tim meninjau profil dan menghubungi kandidat yang paling sesuai.'],
    ],
    formKicker: 'Lamaran cepat',
    formTitle: 'Mulai lewat WhatsApp.',
    formDesc: 'Tidak perlu akun atau surat pengantar panjang. Berikan konteks terbaikmu, lalu lanjutkan percakapan langsung dengan tim kami.',
    formBenefit: ['Format pesan menyesuaikan divisi', 'Data tetap berada di perangkatmu', 'Langsung terhubung ke WhatsApp HR'],
    name: 'Nama lengkap',
    namePh: 'Nama kamu',
    position: 'Posisi yang dilamar',
    positionPh: 'Pilih posisi',
    cv: 'Link CV atau LinkedIn',
    cvPh: 'https://linkedin.com/in/...',
    portfolio: 'Link portofolio',
    portfolioPh: 'Behance, GitHub, Drive, atau website pribadi',
    portfolioOptional: 'opsional',
    initialNote: 'Keahlian atau pengalaman paling relevan',
    initialNotePh: 'Ceritakan singkat hal yang paling relevan dengan posisi pilihanmu...',
    submit: 'Kirim melalui WhatsApp',
    privacy: 'Dengan menekan tombol ini, WhatsApp akan terbuka dengan pesan yang sudah terisi. Kamu tetap bisa mengeditnya sebelum dikirim.',
    messageIntro: 'Halo Tim Rekrutmen Lumovelo, saya tertarik untuk berkolaborasi.',
    thankYou: 'Terima kasih, saya siap berdiskusi lebih lanjut.',
    labels: { name: 'Nama', position: 'Posisi', division: 'Divisi', cv: 'CV / LinkedIn', portfolio: 'Portofolio', note: 'Pengalaman relevan' },
  },
  en: {
    eyebrow: 'Careers at LUMOVELO',
    title: 'Great work begins with healthy collaboration.',
    intro: 'We bring sharp talent, genuine curiosity, and meaningful digital projects together.',
    heroCta: 'Explore open roles',
    remote: 'Remote from Indonesia',
    model: 'Freelance & project contract',
    response: 'Reviewed directly by the team',
    imageCaption: 'Build work you are proud of, from anywhere.',
    jobsKicker: 'Open roles',
    jobsTitle: 'Find the right space for your expertise.',
    jobsDesc: 'Choose a role, review the qualifications, and send your profile through WhatsApp using a format tailored to each division.',
    type: 'Freelance / Contract',
    location: 'Remote',
    detail: 'View qualifications',
    qualification: 'What we are looking for',
    apply: 'Apply for this role',
    processKicker: 'How to join',
    processTitle: 'Short, clear, and directly with the team.',
    process: [
      ['01', 'Choose a division', 'Open the role that best matches your experience and interests.'],
      ['02', 'Send your profile', 'Complete a short form. Your WhatsApp message is formatted automatically.'],
      ['03', 'Start a conversation', 'Our team reviews profiles and contacts the strongest matches.'],
    ],
    formKicker: 'Quick application',
    formTitle: 'Start on WhatsApp.',
    formDesc: 'No account or lengthy cover letter needed. Share your strongest context and continue the conversation directly with our team.',
    formBenefit: ['Division-specific message format', 'Your data stays on your device', 'Connect directly with HR on WhatsApp'],
    name: 'Full name',
    namePh: 'Your name',
    position: 'Role you are applying for',
    positionPh: 'Choose a role',
    cv: 'CV or LinkedIn link',
    cvPh: 'https://linkedin.com/in/...',
    portfolio: 'Portfolio link',
    portfolioPh: 'Behance, GitHub, Drive, or personal website',
    portfolioOptional: 'optional',
    initialNote: 'Most relevant skill or experience',
    initialNotePh: 'Briefly share what is most relevant to your selected role...',
    submit: 'Send via WhatsApp',
    privacy: 'WhatsApp will open with a prepared message. You can still edit it before sending.',
    messageIntro: 'Hello Lumovelo Recruitment Team, I am interested in collaborating.',
