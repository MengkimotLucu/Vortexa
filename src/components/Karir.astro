const vacancies = sharedVacancies.map((job) => ({
  ...job,
  requirements: job.requirements[lang],
  noteLabel: job.noteLabel[lang],
  notePlaceholder: job.notePlaceholder[lang],
}));
---

<section id="karir" class="career-page bg-[#f7f4ef] text-[#211f1c]">
  <div class="hero-band relative overflow-hidden border-b border-[#211f1c]/12">
    <div class="mx-auto grid min-h-[calc(100svh-4rem)] max-w-[1440px] lg:grid-cols-[1.02fr_0.98fr]">
      <div class="flex flex-col justify-between px-5 py-12 sm:px-8 sm:py-16 lg:px-14 lg:py-20 xl:px-20">
        <div class="hero-copy max-w-3xl">
          <div class="mb-10 flex items-center gap-3 text-[11px] font-extrabold uppercase text-blue-700">
            <span class="h-px w-10 bg-blue-700"></span>
            {copy.eyebrow}
          </div>
          <h1 class="max-w-[820px] text-[clamp(2.75rem,6.4vw,6.7rem)] font-extrabold leading-[0.94]">
            {copy.title}
          </h1>
          <div class="mt-9 grid max-w-2xl gap-7 border-t border-[#211f1c]/16 pt-7 sm:grid-cols-[1fr_auto] sm:items-end">
            <p class="max-w-xl text-sm font-semibold leading-7 text-[#625c54] sm:text-base">{copy.intro}</p>
            <a href="#posisi" class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#211f1c] px-5 text-xs font-extrabold uppercase text-[#f7f4ef] transition-colors hover:bg-blue-700">
              {copy.heroCta}
              <ArrowDown size={16} strokeWidth={2.4} className="transition-transform group-hover:translate-y-0.5" />
            </a>
          </div>
        </div>

        <div class="mt-16 grid gap-4 border-t border-[#211f1c]/12 pt-5 text-xs font-bold sm:grid-cols-3 lg:mt-20">
          <span class="flex items-center gap-2"><MapPin size={16} strokeWidth={2} className="text-blue-700" />{copy.remote}</span>
          <span class="flex items-center gap-2"><BriefcaseBusiness size={16} strokeWidth={2} className="text-blue-700" />{copy.model}</span>
          <span class="flex items-center gap-2"><Clock3 size={16} strokeWidth={2} className="text-blue-700" />{copy.response}</span>
        </div>
      </div>

      <figure class="hero-image relative min-h-[520px] overflow-hidden bg-[#d7d4cc] lg:min-h-full">
        <Image
          src={careerHeroImg}
          alt={lang === 'en' ? 'Remote digital professional collaborating with Lumovelo' : 'Profesional digital berkolaborasi secara remote bersama Lumovelo'}
          class="absolute inset-0 h-full w-full object-cover object-center"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
        />
        <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-5 bg-[#255bd6] px-5 py-5 text-[#f7f4ef] sm:px-8">
          <figcaption class="max-w-sm text-sm font-extrabold leading-5">{copy.imageCaption}</figcaption>
          <Sparkles size={24} strokeWidth={1.8} className="shrink-0 text-[#d6f36b]" />
        </div>
      </figure>
    </div>
  </div>

  <section id="posisi" class="scroll-mt-24 border-b border-[#211f1c]/12 px-5 py-20 sm:px-8 lg:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="text-[11px] font-extrabold uppercase text-blue-700">{copy.jobsKicker}</p>
          <h2 class="mt-4 max-w-md text-[clamp(2rem,4vw,4rem)] font-extrabold leading-[1.02]">{copy.jobsTitle}</h2>
          <p class="mt-6 max-w-md text-sm font-semibold leading-7 text-[#6b655d]">{copy.jobsDesc}</p>
          <div class="mt-9 inline-flex items-center gap-3 border-b border-[#211f1c] pb-2 text-xs font-extrabold uppercase">
            <span class="text-blue-700">{String(vacancies.length).padStart(2, '0')}</span>
            {lang === 'en' ? 'roles available' : 'posisi tersedia'}
          </div>
        </div>

        <div class="border-t border-[#211f1c]">
          {vacancies.map((job, index) => (
            <details id={job.id} class="job-row group scroll-mt-24 border-b border-[#211f1c]/18" data-job-id={job.id}>
              <summary class="grid cursor-pointer list-none grid-cols-[2.2rem_1fr_auto] items-center gap-3 py-6 sm:grid-cols-[3rem_1fr_auto] sm:gap-5 sm:py-8">
                <span class="text-xs font-extrabold text-blue-700">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <span class="block text-[10px] font-extrabold uppercase text-[#7a736a]">{job.division}</span>
                  <span class="mt-1.5 block text-lg font-extrabold leading-tight sm:text-2xl">{job.title}</span>
                </span>
                <span class="job-toggle relative flex h-9 w-9 items-center justify-center rounded-full border border-[#211f1c]/30 transition-colors group-open:bg-[#211f1c] group-open:text-[#f7f4ef] sm:h-11 sm:w-11" aria-hidden="true">
                  <span class="absolute h-px w-4 bg-current"></span>
                  <span class="absolute h-4 w-px bg-current transition-transform group-open:rotate-90 group-open:opacity-0"></span>
                </span>
              </summary>

              <div class="job-content grid overflow-hidden pb-8 pl-[3.1rem] sm:pl-[4.25rem]">
                <div class="grid gap-7 bg-[#eeebe4] p-5 sm:p-7 lg:grid-cols-[1fr_auto] lg:items-end">
                  <div>
                    <div class="mb-6 flex flex-wrap gap-2">
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-[#211f1c]/15 bg-[#f7f4ef] px-3 py-1.5 text-[10px] font-extrabold uppercase"><MapPin size={13} /> {copy.location}</span>
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-[#211f1c]/15 bg-[#f7f4ef] px-3 py-1.5 text-[10px] font-extrabold uppercase"><Clock3 size={13} /> {copy.type}</span>
                    </div>
                    <p class="mb-3 text-[10px] font-extrabold uppercase text-[#746d64]">{copy.qualification}</p>
                    <ul class="grid gap-3">
                      {job.requirements.map((requirement) => (
                        <li class="flex gap-3 text-sm font-semibold leading-6 text-[#514c45]">
                          <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full" style={`background:${job.accent}`}><Check size={11} strokeWidth={3} /></span>
                          {requirement}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <button type="button" class="apply-btn group/btn inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-full bg-blue-700 px-5 text-xs font-extrabold uppercase text-white transition-colors hover:bg-[#211f1c]" data-job-id={job.id}>
                    {copy.apply}
                    <ArrowUpRight size={16} strokeWidth={2.4} className="transition-transform group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" />
                  </button>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[#211f1c]/12 bg-[#d6f36b] px-5 py-20 sm:px-8 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <p class="text-[11px] font-extrabold uppercase text-[#3c4b15]">{copy.processKicker}</p>
      <h2 class="mt-4 max-w-3xl text-[clamp(2rem,4.5vw,4.5rem)] font-extrabold leading-[1.02]">{copy.processTitle}</h2>
      <div class="mt-14 grid border-t border-[#211f1c]/35 md:grid-cols-3">
        {copy.process.map(([number, title, description], index) => (
          <article class:list={["py-7 md:py-9", index > 0 && "border-t border-[#211f1c]/35 md:border-l md:border-t-0 md:pl-8", index < 2 && "md:pr-8"]}>
            <span class="text-xs font-extrabold">{number}</span>
            <h3 class="mt-10 text-xl font-extrabold">{title}</h3>
            <p class="mt-3 max-w-sm text-sm font-semibold leading-6 text-[#3e431f]">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="lamar" class="scroll-mt-20 bg-[#211f1c] px-5 py-20 text-[#f7f4ef] sm:px-8 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
      <div>
        <p class="text-[11px] font-extrabold uppercase text-[#a9ccff]">{copy.formKicker}</p>
        <h2 class="mt-4 max-w-lg text-[clamp(2.5rem,5vw,5.2rem)] font-extrabold leading-[0.98]">{copy.formTitle}</h2>
        <p class="mt-7 max-w-md text-sm font-semibold leading-7 text-[#c6c0b7]">{copy.formDesc}</p>
        <ul class="mt-10 grid gap-4 border-t border-[#f7f4ef]/15 pt-6">
          {copy.formBenefit.map((benefit) => (
            <li class="flex items-center gap-3 text-xs font-bold text-[#ddd7ce]"><Check size={16} className="text-[#d6f36b]" />{benefit}</li>
          ))}
        </ul>
      </div>

      <form id="career-application-form" class="grid gap-5 border-t border-[#f7f4ef]/25 pt-7" data-lang={lang} data-wa-number={waNumber}>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-[10px] font-extrabold uppercase" for="applicant-name">
            {copy.name}
            <input id="applicant-name" name="name" type="text" required placeholder={copy.namePh} class="career-input" />
          </label>
          <label class="grid gap-2 text-[10px] font-extrabold uppercase" for="applicant-position">
            {copy.position}
            <span class="relative">
              <select id="applicant-position" name="position" required class="career-input appearance-none pr-12">
                <option value="" disabled selected>{copy.positionPh}</option>
                {vacancies.map((job) => <option value={job.id}>{job.title}</option>)}
              </select>
              <ArrowDown size={16} className="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[#8d867d]" />
            </span>
          </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-[10px] font-extrabold uppercase" for="applicant-cv">
            {copy.cv}
            <input id="applicant-cv" name="cv" type="url" required placeholder={copy.cvPh} class="career-input" />
          </label>
          <label class="grid gap-2 text-[10px] font-extrabold uppercase" for="applicant-portfolio">
            <span>{copy.portfolio} <span class="text-[#8d867d]">({copy.portfolioOptional})</span></span>
            <input id="applicant-portfolio" name="portfolio" type="url" placeholder={copy.portfolioPh} class="career-input" />
          </label>
        </div>

        <label class="grid gap-2 text-[10px] font-extrabold uppercase" for="applicant-note">
          <span id="career-note-label">{copy.initialNote}</span>
          <textarea id="applicant-note" name="note" required rows="4" placeholder={copy.initialNotePh} class="career-input resize-y"></textarea>
        </label>

        <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-md text-[10px] font-semibold leading-5 text-[#9d968d]">{copy.privacy}</p>
          <button type="submit" class="group inline-flex min-h-13 shrink-0 items-center justify-center gap-2 rounded-full bg-[#25d366] px-6 text-xs font-extrabold uppercase text-[#102d1a] transition-colors hover:bg-[#d6f36b]">
            <MessageCircle size={18} strokeWidth={2.4} />
            {copy.submit}
            <ArrowRight size={16} strokeWidth={2.4} className="transition-transform group-hover:translate-x-0.5" />
          </button>
        </div>
      </form>
    </div>
  </section>
</section>

<script is:inline define:vars={{ vacancies, copy }}>
  function initCareerPage() {
    const form = document.getElementById('career-application-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const positionSelect = document.getElementById('applicant-position');
    const noteInput = document.getElementById('applicant-note');
    const noteLabel = document.getElementById('career-note-label');

    const selectedJob = () => vacancies.find((job) => job.id === positionSelect?.value);

    function updateDivisionFormat() {
      const job = selectedJob();
      if (!job || !(noteInput instanceof HTMLTextAreaElement)) return;
      if (noteLabel) noteLabel.textContent = job.noteLabel;
      noteInput.placeholder = job.notePlaceholder;
    }

    positionSelect?.addEventListener('change', updateDivisionFormat);

    document.querySelectorAll('.apply-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const jobId = button.getAttribute('data-job-id');
        if (jobId && positionSelect instanceof HTMLSelectElement) {
          positionSelect.value = jobId;
          updateDivisionFormat();
        }
        document.getElementById('lamar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.setTimeout(() => document.getElementById('applicant-name')?.focus({ preventScroll: true }), 650);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const job = selectedJob();
      if (!job) return;

      const formData = new FormData(form);
      const name = String(formData.get('name') || '').trim();
      const cv = String(formData.get('cv') || '').trim();
      const portfolio = String(formData.get('portfolio') || '').trim();
      const note = String(formData.get('note') || '').trim();
      const portfolioLine = portfolio || '-';

      const message = `${copy.messageIntro}\n\n${copy.labels.name}: ${name}\n${copy.labels.position}: ${job.title}\n${copy.labels.division}: ${job.division}\n${copy.labels.cv}: ${cv}\n${copy.labels.portfolio}: ${portfolioLine}\n${job.noteLabel}: ${note}\n\n${copy.thankYou}`;
      const phone = form.dataset.waNumber || '6285624353611';
      window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCareerPage, { once: true });
  } else {
    initCareerPage();
  }
  document.addEventListener('astro:after-swap', initCareerPage);
</script>

