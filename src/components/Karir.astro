    accent: '#d6f36b',
    requirements: {
      id: [
        'Memahami LLM, OpenAI API, LangChain/Flowise, atau n8n.',
        'Pernah membangun chatbot dan integrasi WhatsApp Business API.',
        'Mandiri, eksploratif, dan cepat beradaptasi dengan teknologi AI baru.',
      ],
      en: [
        'Understand LLMs, OpenAI API, LangChain/Flowise, or n8n.',
        'Experience building chatbots and WhatsApp Business API integrations.',
        'Independent, exploratory, and quick to adapt to emerging AI technology.',
      ],
    },
    noteLabel: { id: 'Tools AI & otomasi yang dikuasai', en: 'AI and automation tools you use' },
    notePlaceholder: { id: 'Contoh: n8n, OpenAI API, Flowise; pernah membuat chatbot customer service...', en: 'Example: n8n, OpenAI API, Flowise; built a customer service chatbot...' },
  },
