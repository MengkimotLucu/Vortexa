---
const lang = Astro.currentLocale === 'en' ? 'en' : 'id';
const content = {
  id: {
    eyebrow: 'APAKAH INI UNTUK ANDA?',
    title: 'Website yang dibuat untuk membantu bisnis bergerak lebih jelas.',
    desc: 'Cocok untuk pemilik bisnis, profesional, dan startup yang membutuhkan partner digital langsung, bukan proses agensi yang berlapis.',
    items: [
      ['Bisnis lokal & UMKM', 'Tampilkan layanan, lokasi, dan keunggulan Anda dengan lebih meyakinkan.'],
      ['Jasa profesional', 'Ubah pengunjung website menjadi enquiry yang lebih terarah.'],
      ['Startup & produk digital', 'Bangun landing page atau sistem web yang siap diuji dan dikembangkan.']
    ],
    note: 'Anda berkomunikasi langsung dengan orang yang merancang dan mengerjakan proyek Anda.'
  },
  en: {
    eyebrow: 'IS THIS FOR YOU?',
    title: 'A website built to make your business easier to understand.',
    desc: 'For business owners, professionals, and startups who want a direct digital partner instead of a layered agency process.',
    items: [
      ['Local businesses & SMEs', 'Present your services, location, and value with more clarity.'],
      ['Professional services', 'Turn website visitors into more focused enquiries.'],
      ['Startups & digital products', 'Launch a landing page or web system that can be tested and improved.']
    ],
    note: 'You communicate directly with the person designing and building your project.'
  }
}[lang];
---

<section class="relative overflow-hidden py-16 lg:py-24 bg-[#f5f8ff]">
  <div class="absolute -top-40 left-[8%] h-80 w-80 rounded-full bg-blue-400/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 right-[5%] h-96 w-96 rounded-full bg-cyan-400/10 blur-3xl pointer-events-none"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/40 to-transparent pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-[.82fr_1.18fr] gap-12 lg:gap-20 items-center">
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-[.18em] text-blue-600 uppercase">
          <span class="h-2 w-2 rounded-full bg-cyan-400 shadow-[0_0_12px_rgba(34,211,238,.9)]"></span>
          {content.eyebrow}
        </p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-display font-black tracking-tight leading-tight text-slate-900">{content.title}</h2>
        <p class="mt-5 text-slate-600 leading-relaxed">{content.desc}</p>
        <p class="mt-7 rounded-r-xl border-l-2 border-blue-600 bg-white/70 px-4 py-3 text-sm font-bold text-slate-800 leading-relaxed shadow-[0_8px_30px_rgba(37,99,235,.08)]">{content.note}</p>
      </div>
      <div class="relative min-h-[390px] flex items-center justify-center">
        <div class="absolute left-[8%] top-[12%] h-44 w-44 rounded-full bg-blue-400/20 blur-3xl"></div>
        <div class="absolute right-[8%] bottom-[8%] h-40 w-40 rounded-full bg-cyan-400/20 blur-3xl"></div>

        <div class="absolute left-0 top-12 z-20 hidden sm:flex items-center gap-3 rounded-2xl border border-white/80 bg-white/90 px-4 py-3 shadow-[0_14px_40px_rgba(37,99,235,.16)] backdrop-blur-sm floating-sticker">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white shadow-[0_0_18px_rgba(37,99,235,.45)]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
          <span><strong class="block text-xs text-slate-900">Direct access</strong><small class="text-[10px] text-slate-500">No agency layers</small></span>
        </div>

        <div class="absolute right-0 bottom-10 z-20 hidden sm:flex items-center gap-3 rounded-2xl border border-cyan-100 bg-white/90 px-4 py-3 shadow-[0_14px_40px_rgba(6,182,212,.16)] backdrop-blur-sm floating-sticker-delayed">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-400 text-slate-950 shadow-[0_0_18px_rgba(34,211,238,.5)]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>
          </span>
          <span><strong class="block text-xs text-slate-900">SEO ready</strong><small class="text-[10px] text-slate-500">Built for discovery</small></span>
        </div>

        <div class="relative z-10 w-[230px] rounded-[2.4rem] border-[7px] border-slate-900 bg-slate-900 p-2 shadow-[0_24px_70px_rgba(15,23,42,.28),0_0_45px_rgba(37,99,235,.2)] rotate-[-4deg] transition-transform duration-500 hover:rotate-0 hover:scale-[1.03]">
          <div class="absolute left-1/2 top-0 z-20 h-5 w-24 -translate-x-1/2 rounded-b-2xl bg-slate-900"></div>
          <div class="overflow-hidden rounded-[1.8rem] bg-white">
            <div class="bg-gradient-to-br from-blue-700 via-blue-600 to-cyan-400 px-5 pb-6 pt-10 text-white">
              <div class="flex items-center justify-between text-[9px] font-bold tracking-widest"><span>LUMOVELO</span><span class="h-2 w-2 rounded-full bg-cyan-200 shadow-[0_0_8px_#a5f3fc]"></span></div>
              <p class="mt-8 text-[10px] font-medium text-blue-100">YOUR DIGITAL PRESENCE</p>
              <p class="mt-1 text-xl font-black leading-tight">Built to<br/>be found.</p>
              <div class="mt-5 inline-flex rounded-full bg-white/15 px-3 py-1 text-[9px] font-bold backdrop-blur-sm">Explore website →</div>
            </div>
            <div class="space-y-3 bg-slate-50 p-4">
              <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-full bg-blue-100">
                  <svg viewBox="0 0 40 40" class="h-8 w-8" aria-label="Illustration of a digital creator" role="img"><circle cx="20" cy="20" r="18" fill="#dbeafe"/><circle cx="20" cy="16" r="6" fill="#fbbf88"/><path d="M10 35c1-8 5-12 10-12s9 4 10 12" fill="#1e3a8a"/><path d="M14 15c1-7 11-8 13 1-3-2-7-3-13-1" fill="#172554"/></svg>
                </div>
                <div><p class="text-[9px] font-bold text-slate-900">Direct collaboration</p><p class="text-[8px] text-slate-500">Built around your business</p></div>
              </div>
              <div class="rounded-xl bg-slate-900 p-3 text-white"><div class="flex justify-between text-[8px] font-bold"><span>Project clarity</span><span class="text-cyan-300">92%</span></div><div class="mt-2 h-1.5 rounded-full bg-slate-700"><div class="h-full w-[92%] rounded-full bg-gradient-to-r from-blue-400 to-cyan-300"></div></div></div>
            </div>
          </div>
        </div>
      </div>
      </div>
      <div class="grid sm:grid-cols-3 gap-8 mt-14">
        {content.items.map(([title, desc], index) => (
          <article class="border-t-2 border-blue-600/70 pt-4 shadow-[0_-8px_28px_rgba(37,99,235,.06)]">
            <p class="text-xs font-mono font-bold text-blue-600 drop-shadow-[0_0_8px_rgba(37,99,235,.35)]">0{index + 1}</p>
            <h3 class="mt-5 text-lg font-bold text-slate-900 leading-snug">{title}</h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
