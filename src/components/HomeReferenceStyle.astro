---
import { Image } from "astro:assets";
import Footer from "./Footer.astro";
import heroImage from "../assets/lumovelo-home-hero.png";
import imgFasteat from "../assets/portfolio-fasteat-mockup.webp";
import imgApex from "../assets/portfolio-company-profile.webp";
import imgFruit from "../assets/portfolio-buah-mockup.webp";
import imgMaintenance from "../assets/portfolio-maintenance.webp";
import imgRedesign from "../assets/portfolio-redesign-web.webp";

const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "6285624353611";
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent("Halo Lumovelo, saya ingin konsultasi pembuatan website.")}`;

const projects = [
  {
    title: "FastEat Cafe & Restaurant",
    type: "Landing Page F&B",
    desc: "Landing page restoran dengan visual menu, CTA reservasi, dan struktur informasi yang ringkas.",
    image: imgFasteat,
    href: "https://fasteat-theta.vercel.app/",
  },
  {
    title: "FruitFresh Organic Store",
    type: "Toko Online",
    desc: "Tampilan e-commerce produk buah organik dengan katalog bersih dan alur pembelian jelas.",
    image: imgFruit,
    href: "https://ecommercebuah.vercel.app/",
  },
];

const benefits = [
  {
    title: "Desain Custom",
    desc: "Website dirancang sesuai karakter bisnis Anda, bukan sekadar template generik yang terlihat sama seperti kompetitor.",
    proof: "Brand-fit layout",
    accent: "bg-blue-600 text-white",
    href: "/layanan/web/",
  },
  {
    title: "SEO Friendly",
    desc: "Struktur halaman, heading, metadata, dan internal link disiapkan agar website lebih mudah dipahami mesin pencari.",
    proof: "Technical SEO",
    accent: "bg-[#101820] text-white",
    href: "/layanan/seo/",
  },
  {
    title: "Fokus Konversi",
    desc: "Setiap section diarahkan untuk membantu pengunjung memahami layanan, percaya pada bisnis Anda, lalu mengambil tindakan.",
    proof: "CTA strategy",
    accent: "bg-[#d9d2c6] text-[#101820]",
    href: "/layanan/web/",
  },
  {
    title: "Responsif & Cepat",
    desc: "Tampilan website dibuat nyaman di desktop, tablet, dan mobile dengan perhatian pada performa loading.",
    proof: "Mobile-first build",
    accent: "bg-[#eee8dc] text-[#101820]",
    href: "/layanan/web/",
  },
  {
    title: "Harga Transparan",
    desc: "Scope, fitur, estimasi waktu, dan biaya dijelaskan sejak awal agar keputusan proyek lebih jelas.",
    proof: "Clear scope",
    accent: "bg-[#171512] text-white",
    href: "/kontak/",
  },
  {
    title: "Support Setelah Launch",
    desc: "Setelah website online, Anda tetap mendapat pendampingan sesuai paket untuk revisi, update, dan kebutuhan teknis.",
    proof: "Post-launch care",
    accent: "bg-blue-100 text-blue-700",
    href: "/kontak/",
  },
];

const process = [
  ["Konsultasi", "Memahami kebutuhan bisnis dan tujuan website."],
  ["Perencanaan", "Menentukan sitemap, fitur, konten, dan prioritas halaman."],
  ["Desain", "Membuat arah UI/UX yang sesuai identitas bisnis."],
  ["Pengembangan", "Mengubah desain menjadi website responsif dan cepat."],
  ["Peluncuran", "Testing, deployment, domain, SSL, dan konfigurasi dasar."],
];
---

<main class="lv-home bg-[#f7f4ef] text-[#141414] min-h-screen">
  <section class="relative mx-auto grid max-w-7xl overflow-hidden px-5 pb-14 pt-20 lg:min-h-[650px] lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:pb-20 lg:pt-24">
    <div class="relative z-10 flex flex-col justify-center">
      <p class="text-[11px] font-black uppercase tracking-[0.18em] text-black/50">Website Development / SEO / AI Automation</p>
      <h1 class="mt-5 max-w-2xl text-[2.75rem] font-black leading-[0.94] sm:text-6xl lg:text-7xl">
        Solusi Digital untuk Bisnis yang Bertumbuh.
      </h1>
      <p class="mt-6 max-w-xl text-sm font-semibold leading-7 text-black/60">
        Lumovelo membantu bisnis, UMKM, startup, dan perusahaan membangun website profesional yang cepat, responsif, SEO-friendly, dan dirancang untuk menghasilkan pelanggan.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-blue-600 px-5 py-3 text-xs font-black uppercase tracking-wide text-white shadow-sm">
          Mulai Konsultasi
        </a>
        <a href="#project" class="rounded-full border border-black/15 px-5 py-3 text-xs font-black uppercase tracking-wide text-black">
          Lihat Project
        </a>
      </div>
      <div class="mt-12 grid max-w-lg grid-cols-3 gap-6 pt-6">
        <div>
          <p class="text-2xl font-black">01</p>
          <p class="mt-1 text-[11px] font-bold uppercase text-black/50">Custom Design</p>
        </div>
        <div>
          <p class="text-2xl font-black">02</p>
          <p class="mt-1 text-[11px] font-bold uppercase text-black/50">SEO Ready</p>
        </div>
        <div>
          <p class="text-2xl font-black">03</p>
          <p class="mt-1 text-[11px] font-bold uppercase text-black/50">Fast Launch</p>
        </div>
      </div>
    </div>

    <div class="relative min-h-[420px] lg:min-h-0">
      <Image src={heroImage} alt="Laptop dengan tampilan website Lumovelo di meja kerja yang hangat" class="absolute inset-y-0 -right-28 my-auto h-[88%] w-[125%] max-w-none object-contain object-center mix-blend-multiply lg:h-[96%] lg:w-[132%]" loading="eager" />
      <div class="absolute bottom-8 left-6 rounded-full bg-[#151515] px-4 py-2 text-xs font-black uppercase tracking-wide text-white shadow-sm lg:left-20">
        Website / SEO / AI
      </div>
    </div>
  </section>

  <section id="layanan" class="bg-[#f7f4ef] py-[72px] md:py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1fr] lg:items-end">
        <div>
          <p class="text-[11px] font-black uppercase tracking-[0.24em] text-blue-600">Layanan Utama</p>
          <h2 class="mt-4 max-w-2xl text-[2.7rem] font-black leading-[0.98] text-[#101820] sm:text-6xl">
            Solusi Digital untuk Setiap <span class="text-blue-600">Tahap Bisnis Anda.</span>
          </h2>
        </div>
        <div class="max-w-xl lg:pb-4">
          <p class="text-base font-semibold leading-8 text-[#526071]">
            Dari website sederhana sampai sistem digital yang lebih custom, Lumovelo membantu memilih solusi yang benar-benar relevan dengan tujuan dan tahap bisnis Anda.
          </p>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-11 items-center gap-3 text-sm font-black text-blue-600">
            Konsultasi Kebutuhan Anda
            <span aria-hidden="true" class="text-2xl leading-none">-></span>
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-3 lg:grid-cols-12">
        <a href="/layanan/web/" class="group relative min-h-[330px] overflow-hidden rounded-[8px] bg-[#e7e1d7] p-7 text-[#101820] lg:col-span-6">
          <Image src={imgApex} alt="Contoh website development untuk company profile bisnis" class="absolute inset-y-0 right-0 h-full w-[68%] object-cover object-left opacity-75 transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#e7e1d7] via-[#e7e1d7]/92 to-[#e7e1d7]/10"></div>
          <div class="relative z-10 flex h-full max-w-xs flex-col">
            <div class="mb-5 flex items-center gap-4">
              <span class="text-sm font-black">01</span>
              <span class="h-px w-9 bg-[#101820]/35"></span>
            </div>
            <h3 class="text-3xl font-black leading-tight">Website Development</h3>
            <p class="mt-4 text-sm font-semibold leading-7 text-[#526071]">
              Website profesional yang cepat, responsif, dan SEO-friendly untuk bisnis, perusahaan, maupun UMKM.
            </p>
            <span class="mt-auto inline-flex items-center gap-3 pt-8 text-sm font-black">Lihat detail <span class="text-2xl">-></span></span>
          </div>
        </a>

        <a href="/layanan/web/" class="group relative min-h-[330px] overflow-hidden rounded-[8px] bg-[#171512] p-7 text-white lg:col-span-6">
          <Image src={imgFruit} alt="Contoh toko online dan katalog produk digital" class="absolute inset-y-0 right-0 h-full w-[62%] object-cover object-left opacity-65 transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#171512] via-[#171512]/86 to-[#171512]/25"></div>
          <div class="relative z-10 flex h-full max-w-xs flex-col">
            <div class="mb-5 flex items-center gap-4">
              <span class="text-sm font-black">02</span>
              <span class="h-px w-9 bg-white/35"></span>
            </div>
            <h3 class="text-3xl font-black leading-tight">E-Commerce</h3>
            <p class="mt-4 text-sm font-semibold leading-7 text-white/72">
              Toko online modern dengan katalog produk, checkout aman, integrasi WhatsApp, dan alur pesanan yang mudah.
            </p>
            <span class="mt-auto inline-flex items-center gap-3 pt-8 text-sm font-black">Lihat detail <span class="text-2xl">-></span></span>
          </div>
        </a>

        <a href="/layanan/web/" class="group relative min-h-[270px] overflow-hidden rounded-[8px] bg-[#f0ece4] p-7 text-[#101820] lg:col-span-4">
          <Image src={imgRedesign} alt="Dashboard custom web app untuk kebutuhan bisnis" class="absolute bottom-0 right-0 h-[92%] w-[60%] object-cover object-left opacity-70 transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#f0ece4] via-[#f0ece4]/92 to-[#f0ece4]/20"></div>
          <div class="relative z-10 flex h-full max-w-[230px] flex-col">
            <div class="mb-4 flex items-center gap-4">
              <span class="text-sm font-black">03</span>
              <span class="h-px w-8 bg-[#101820]/35"></span>
            </div>
            <h3 class="text-2xl font-black leading-tight">Custom Web App</h3>
            <p class="mt-4 text-sm font-semibold leading-7 text-[#526071]">
              Sistem web sesuai kebutuhan bisnis Anda, seperti dashboard, portal client, dan fitur berbasis data.
            </p>
            <span class="mt-auto inline-flex items-center gap-3 pt-6 text-sm font-black">Lihat detail <span class="text-2xl">-></span></span>
          </div>
        </a>

        <a href="/layanan/seo/" class="group relative min-h-[270px] overflow-hidden rounded-[8px] bg-[#d9d2c6] p-7 text-[#101820] lg:col-span-4">
          <Image src={imgMaintenance} alt="Optimasi SEO dan performa website bisnis" class="absolute inset-y-0 right-0 h-full w-[56%] object-cover object-left opacity-[0.42] transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#d9d2c6] via-[#d9d2c6]/90 to-[#d9d2c6]/35"></div>
          <div class="relative z-10 flex h-full max-w-[230px] flex-col">
            <div class="mb-4 flex items-center gap-4">
              <span class="text-sm font-black">04</span>
              <span class="h-px w-8 bg-[#101820]/35"></span>
            </div>
            <h3 class="text-2xl font-black leading-tight">SEO</h3>
            <p class="mt-4 text-sm font-semibold leading-7 text-[#526071]">
              Optimasi struktur website, konten, dan performa teknis agar lebih mudah ditemukan di Google.
            </p>
            <span class="mt-auto inline-flex items-center gap-3 pt-6 text-sm font-black">Lihat detail <span class="text-2xl">-></span></span>
          </div>
        </a>

        <a href="/layanan/ai/" class="group relative min-h-[270px] overflow-hidden rounded-[8px] bg-[#eee8dc] p-7 text-[#101820] lg:col-span-4">
          <Image src={heroImage} alt="AI automation dan chatbot untuk bisnis" class="absolute inset-y-0 right-[-18%] h-full w-[78%] object-cover object-center opacity-55 transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#eee8dc] via-[#eee8dc]/88 to-[#eee8dc]/35"></div>
          <div class="absolute bottom-7 right-6 hidden rounded-2xl bg-[#171512] p-4 text-white shadow-xl sm:block">
            <p class="text-[10px] font-black uppercase text-white/60">AI Assistant</p>
            <p class="mt-2 max-w-[150px] text-xs font-semibold leading-5 text-white/80">Bagaimana saya bisa membantu?</p>
          </div>
          <div class="relative z-10 flex h-full max-w-[230px] flex-col">
            <div class="mb-4 flex items-center gap-4">
              <span class="text-sm font-black">05</span>
              <span class="h-px w-8 bg-[#101820]/35"></span>
            </div>
            <h3 class="text-2xl font-black leading-tight">AI Automation</h3>
            <p class="mt-4 text-sm font-semibold leading-7 text-[#526071]">
              Chatbot, otomasi leads, integrasi workflow, dan solusi AI lainnya untuk meningkatkan efisiensi operasional bisnis.
            </p>
            <span class="mt-auto inline-flex items-center gap-3 pt-6 text-sm font-black">Lihat detail <span class="text-2xl">-></span></span>
          </div>
        </a>
      </div>

      <div class="mt-10 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <p class="text-[11px] font-black uppercase tracking-[0.24em] text-[#526071]">Butuh solusi yang lebih spesifik?</p>
        <p class="text-sm font-semibold text-[#526071]">Diskusikan kebutuhan Anda langsung dengan tim kami.</p>
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#101820] px-7 text-sm font-black text-white transition-transform duration-200 hover:-translate-y-0.5">
          Mulai Diskusi <span class="text-xl">-></span>
        </a>
      </div>
    </div>
  </section>

  <section id="project" class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="flex flex-col justify-between gap-5 pb-7 md:flex-row md:items-end">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.18em] text-black/45">Project Pilihan</p>
        <h2 class="mt-3 text-4xl font-black leading-none">Project yang Kami Rancang.</h2>
      </div>
      <a href="/portofolio/" class="text-xs font-black uppercase tracking-wide text-blue-600">Lihat semua project -></a>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {projects.slice(0, 3).map((project) => (
        <a href={project.href} target={project.href.startsWith("http") ? "_blank" : undefined} rel={project.href.startsWith("http") ? "noopener noreferrer" : undefined} class="group block">
          <div class="aspect-[1.2/1] overflow-hidden bg-black">
            <Image src={project.image} alt={`Project ${project.title} oleh Lumovelo`} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" loading="lazy" />
          </div>
          <p class="mt-5 text-[11px] font-black uppercase tracking-wide text-blue-600">{project.type}</p>
          <h3 class="mt-2 text-xl font-black">{project.title}</h3>
          <p class="mt-2 text-xs font-semibold leading-6 text-black/55">{project.desc}</p>
        </a>
      ))}
    </div>

  </section>

  <section class="bg-[#f7f4ef] py-20 md:py-28">
    <div class="mx-auto grid max-w-7xl items-stretch gap-10 px-5 lg:grid-cols-12 lg:gap-8 lg:px-8">
      <div class="lg:col-span-4 lg:h-full">
        <div class="lg:flex lg:h-full lg:flex-col">
          <p class="text-[11px] font-black uppercase tracking-[0.24em] text-blue-600">Kenapa Lumovelo</p>
          <h2 class="mt-5 max-w-md text-[2.8rem] font-black leading-[0.98] text-[#101820] sm:text-6xl lg:text-[3.25rem]">
            Fokus pada Hasil, Bukan Sekadar <span class="text-blue-600">Website.</span>
          </h2>
          <div class="mt-8 h-px w-10 bg-[#101820]"></div>
          <p class="mt-7 max-w-sm text-base font-medium leading-7 text-[#526071]">
            Kami percaya website yang baik bukan hanya tentang tampilan, tetapi tentang dampak nyata untuk bisnis Anda. Setiap solusi dirancang dengan tujuan, strategi, dan teknologi yang tepat.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#101820] px-6 text-sm font-black text-white transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600">
              Diskusikan Project Anda <span aria-hidden="true" class="text-xl">-></span>
            </a>
            <p class="max-w-[150px] text-[10px] font-black uppercase leading-4 text-[#6b7684]">Berbasis di Indonesia<br />Melayani klien di seluruh dunia</p>
          </div>
          <div class="relative mt-9 min-h-[290px] overflow-hidden rounded-[8px] bg-[#171512] sm:min-h-[350px] lg:min-h-[410px] lg:flex-1">
            <Image src={heroImage} alt="Workspace Lumovelo untuk strategi website bisnis" class="absolute inset-0 h-full w-full object-cover object-center opacity-80" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#101820]/85 via-transparent to-transparent"></div>
            <p class="absolute bottom-7 left-7 text-[11px] font-black uppercase leading-5 tracking-[0.16em] text-white">Digital solutions<br />for a brighter tomorrow</p>
          </div>
        </div>
      </div>

      <div class="grid content-start gap-3 sm:grid-cols-2 lg:col-span-8">
        {benefits.map((item, index) => (
          <article class="group h-full rounded-[8px] border border-[#101820]/10 bg-[#fbfaf7] transition-colors duration-300 hover:border-blue-600/35 hover:bg-white">
            <a href={item.href} class="flex h-full min-h-[238px] flex-col p-6 sm:p-7">
              <div class="flex items-start justify-between gap-5">
                <div class={`inline-flex min-h-10 items-center rounded-full px-4 text-[10px] font-black uppercase tracking-[0.16em] ${item.accent}`}>
                  {item.proof}
                </div>
                <span class="text-sm font-black text-[#101820]/35">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="mt-9">
                <h3 class="text-[1.55rem] font-black leading-[1.05] text-[#101820]">{item.title}</h3>
                <p class="mt-4 text-sm font-medium leading-6 text-[#526071]">{item.desc}</p>
              </div>
              <span class="mt-auto inline-flex min-h-11 items-end gap-3 pt-7 text-sm font-black text-[#101820] transition-colors group-hover:text-blue-600">
                <span class="sr-only">Lihat detail {item.title}</span>
                <span aria-hidden="true" class="text-2xl font-medium">-></span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="proses" class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.18em] text-black/45">Proses Pembuatan</p>
        <h2 class="mt-3 text-4xl font-black leading-none">Dari Ide ke Hasil Nyata.</h2>
      </div>
      <div class="grid gap-2">
        {process.map(([title, desc], index) => (
          <article class="grid gap-4 rounded-sm bg-[#ede8df] px-5 py-5 sm:grid-cols-[80px_1fr_1.2fr]">
            <p class="text-sm font-black text-blue-600">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="text-base font-black">{title}</h3>
            <p class="text-sm font-semibold leading-6 text-black/55">{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="relative min-h-[170px] overflow-hidden bg-[#111] text-white">
      <Image src={imgFasteat} alt="Preview project FastEat Cafe & Restaurant" class="absolute inset-y-0 right-0 h-full w-full object-cover object-top opacity-25 md:w-[58%] md:opacity-35" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#111] via-[#111]/95 to-[#111]/45"></div>
      <div class="relative z-10 grid min-h-[170px] gap-5 px-7 py-7 md:grid-cols-[0.9fr_1.1fr] md:items-center md:px-10">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.18em] text-white/45">Siap Bertumbuh?</p>
          <h2 class="mt-3 max-w-md text-3xl font-black leading-none md:text-4xl">Mari Wujudkan Ide Anda Bersama.</h2>
        </div>
        <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-end">
          <p class="max-w-sm text-xs font-semibold leading-6 text-white/65">
            Ceritakan kebutuhan website Anda. Saya bantu petakan jenis website, estimasi fitur, dan langkah pengerjaan yang masuk akal.
          </p>
          <div class="flex shrink-0 flex-wrap gap-3">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-blue-600 px-5 py-3 text-[11px] font-black uppercase tracking-wide text-white">Mulai Diskusi</a>
            <a href="/portofolio/" class="rounded-full border border-white/25 px-5 py-3 text-[11px] font-black uppercase tracking-wide text-white">Lihat Portfolio</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</main>

<style>
  .lv-home :global(.max-w-7xl),
  .lv-home :global(.max-w-6xl) {
    max-width: 1180px !important;
  }

  .lv-home h1,
  .lv-home h2,
  .lv-home h3,
  .lv-home p {
    letter-spacing: 0 !important;
  }
</style>
