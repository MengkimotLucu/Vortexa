        bgCategory: 'bg-teal-100 text-teal-700 border-teal-200',
        description: 'Mengenal arsitektur website modern tanpa database tradisional untuk kecepatan loading maksimal di bawah 1 detik dan bebas retasan.'
      },
      {
        slug: 'strategi-technical-seo-lokal',
        title: 'Panduan Memulai Technical SEO untuk Meningkatkan Peringkat Bisnis Anda di Google Search',
        date: '28 JUNI 2026',
        category: 'SEO & MARKETING',
        bgCategory: 'bg-blue-100 text-blue-650 border-blue-200',
        description: 'Langkah-langkah praktis mengoptimasi struktur website, sitemap, dan meta tag agar bisnis Anda mudah ditemukan pelanggan di Google.'
      },
      {
        slug: 'peran-video-creative-landing-page',
        title: 'Cara Video Creative Menarik Perhatian Pengunjung dan Menaikkan Konversi Penjualan Hingga 40%',
        date: '25 JUNI 2026',
        category: 'VIDEO & CREATIVE',
        bgCategory: 'bg-purple-100 text-purple-700 border-purple-200',
        description: 'Mengapa menyertakan konten video pendek berkualitas sangat berdampak pada penurunan bounce rate website produk dan meyakinkan calon pelanggan.'
      },
      {
        slug: 'analisis-performa-web-lighthouse',
        title: 'Cara Mengukur dan Meningkatkan Skor Google Lighthouse Website Anda Hingga 100',
        date: '20 JUNI 2026',
        category: 'IT & WEB DEVELOP',
        bgCategory: 'bg-teal-100 text-teal-700 border-teal-200',
        description: 'Panduan mendalam mengoptimasi kecepatan muat, struktur gambar Next-Gen, dan menghilangkan render-blocking resources untuk performa sempurna.'
      },
      {
        slug: 'tren-desain-web-minimalis',
        title: 'Tren Desain Website Minimalis Modern yang Meningkatkan Kepercayaan Brand Anda',
        date: '15 JUNI 2026',
        category: 'VIDEO & CREATIVE',
        bgCategory: 'bg-purple-100 text-purple-700 border-purple-200',
        description: 'Bagaimana perpaduan tipografi berani, ruang putih yang luas, dan mikro animasi dapat membuat website perusahaan Anda terlihat premium.'
      }
    ]
  },
  en: {
    sectionHeader: "Insights & Education",
    title1: "Tech Discourses.",
    title2: "No BS Education.",
    desc: "We write technical articles to share insights on high-performance web optimization, autonomous AI automation, and SEO tactics that actually work.",
    readMore: "/ READ MORE",
    posts: [
      {
        slug: 'otomatisasi-leads-ai-whatsapp',
        title: 'How to Use AI Chatbots to Automatically Answer WhatsApp Customers 24/7',
        date: '05 JULY 2026',
        category: 'AI & AUTOMATION',
        bgCategory: 'bg-indigo-100 text-indigo-750 border-indigo-200',
        description: 'Save customer service operational time with smart autonomous AI agent integration on your business WhatsApp chat.'
      },
      {
        slug: 'keunggulan-website-headless-modern',
        title: 'Why Headless Serverless Websites Are Blazing Fast and Highly Secure Compared to WordPress',
        date: '02 JULY 2026',
        category: 'IT & WEB DEV',
        bgCategory: 'bg-teal-100 text-teal-700 border-teal-200',
        description: 'Understand modern database-free website architectures for maximum loading speed under 1 second and high resistance to hacking.'
      },
      {
        slug: 'strategi-technical-seo-lokal',
        title: 'Beginner\'s Guide to Technical SEO: Boosting Your Business Ranking on Google Search',
        date: '28 JUNE 2026',
        category: 'SEO & MARKETING',
        bgCategory: 'bg-blue-100 text-blue-650 border-blue-200',
        description: 'Practical steps to optimize website structure, sitemap, and meta tags so your business is easily discovered by customers on Google.'
      },
      {
        slug: 'peran-video-creative-landing-page',
        title: 'How Creative Video Assets Hook Visitors and Increase Sales Conversion by Up to 40%',
        date: '25 JUNE 2026',
        category: 'VIDEO & CREATIVE',
        bgCategory: 'bg-purple-100 text-purple-700 border-purple-200',
        description: 'Why high-quality short video assets dramatically decrease bounce rates and convince potential customers on your landing page.'
      },
      {
        slug: 'analisis-performa-web-lighthouse',
        title: 'How to Measure and Improve Your Google Lighthouse Web Score to 100',
        date: '20 JUNE 2026',
        category: 'IT & WEB DEV',
        bgCategory: 'bg-teal-100 text-teal-700 border-teal-200',
        description: 'In-depth guide to optimizing loading speed, Next-Gen image formats, and eliminating render-blocking resources for flawless performance.'
      },
      {
        slug: 'tren-desain-web-minimalis',
        title: 'Modern Minimalist Web Design Trends that Boost Your Brand Authority',
        date: '15 JUNE 2026',
        category: 'VIDEO & CREATIVE',
        bgCategory: 'bg-purple-100 text-purple-700 border-purple-200',
        description: 'How a mix of bold typography, generous white space, and micro-interactions can make your corporate website look extremely premium.'
      }
    ]
  }
}[lang];

// Fetch dynamic posts from database
let dbPosts = [];
try {
  const { data, error } = await supabase
    .from('posts')
    .select('*')
    .order('created_at', { ascending: false });
  if (data && data.length > 0) {
    dbPosts = data;
  }
} catch (e) {
  console.error('Error loading posts from database:', e);
}

// Fallback to static posts if database is empty
const rawPosts = dbPosts.length > 0 ? dbPosts : content.posts;

const posts = rawPosts.map(p => ({
  slug: p.slug,
  title: p.title,
  date: p.date,
  category: p.category,
  bgCategory: p.bg_category || p.bgCategory || 'bg-blue-100 text-blue-650 border-blue-200',
  description: p.description
}));
---
<section id="blog" class="py-24 bg-white relative overflow-hidden border-t-2 border-slate-100">
  <div class="absolute inset-0 bg-[radial-gradient(rgba(37,99,235,0.015)_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <!-- Left-aligned Section Header -->
    <div class="mb-12 text-left reveal-on-scroll">
      <h2 class="font-mono font-bold text-xs tracking-widest text-blue-600 uppercase">{content.sectionHeader}</h2>
      <h1 class="font-display font-black text-4xl sm:text-5xl text-slate-900 uppercase tracking-tight leading-[1.0] mt-3">
        {content.title1}<br/>
        <span class="text-stroke-neon">{content.title2}</span>
      </h1>
      <p class="text-slate-500 mt-6 text-sm sm:text-base leading-relaxed font-semibold max-w-2xl">
        {content.desc}
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap gap-2.5 mb-14 border-b border-slate-100 pb-8 reveal-on-scroll">
      <button data-filter="ALL" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-slate-950 text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer shadow-[3px_3px_0px_#2563eb]">
        SEMUA
      </button>
      <button data-filter="AI & OTOMATISASI" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-white text-slate-950 hover:bg-slate-950 hover:text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
        AI & Otomatisasi
      </button>
      <button data-filter="IT & WEB DEVELOP" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-white text-slate-950 hover:bg-slate-950 hover:text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
        IT & Web Develop
      </button>
      <button data-filter="SEO & MARKETING" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-white text-slate-950 hover:bg-slate-950 hover:text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
        SEO & Marketing
      </button>
      <button data-filter="VIDEO & CREATIVE" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-white text-slate-950 hover:bg-slate-950 hover:text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
        Video & Creative
      </button>
      <button data-filter="KEAMANAN JARINGAN" class="btn-filter-tab px-5 py-2.5 rounded-full border-2 border-slate-950 bg-white text-slate-950 hover:bg-slate-950 hover:text-white font-mono font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
        Keamanan Jaringan
      </button>
    </div>

    <!-- Blog Grid -->
    <div id="latest-posts-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {posts.map((post) => (
        <article 
          data-category={post.category}
          class="blog-post-card p-8 bg-white border-2 border-slate-950 rounded-3xl shadow-[5px_5px_0px_#0f172a] hover:shadow-[2px_2px_0px_#0f172a] hover:translate-x-0.5 hover:translate-y-0.5 transition-all flex flex-col justify-between h-full reveal-on-scroll"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between text-[10px] font-mono font-bold text-slate-400">
              <span>{post.date}</span>
              <span class={`px-2.5 py-0.5 rounded-full border text-[9px] uppercase tracking-wider ${post.bgCategory}`}>{post.category}</span>
            </div>
            <h4 class="font-display font-black text-xl text-slate-900 uppercase hover:text-blue-600 transition-colors leading-tight">
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h4>
            <p class="text-xs text-slate-500 font-semibold leading-relaxed text-justify">
              {post.description}
            </p>
          </div>
          <div class="border-t border-slate-100 pt-5 mt-6">
            <a href={`/blog/${post.slug}/`} class="text-[10px] font-mono font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1.5 uppercase tracking-wider">
              {content.readMore} 
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Pagination Container -->
    <div id="blog-pagination" class="flex items-center justify-center gap-2.5 mt-14 reveal-on-scroll">
      <!-- Will be populated dynamically by JavaScript -->
    </div>
  </div>
</section>

<script>
  const filterTabs = document.querySelectorAll('.btn-filter-tab');
  const postCards = Array.from(document.querySelectorAll('.blog-post-card')) as HTMLElement[];
  const paginationContainer = document.getElementById('blog-pagination') as HTMLDivElement;

  const postsPerPage = 4;
  let currentPage = 1;
  let currentFilter = 'ALL';

  function updatePagination() {
    // 1. Filter the post cards based on the selected category
    const filteredCards = postCards.filter(card => {
      const cardCat = card.getAttribute('data-category');
      return currentFilter === 'ALL' || cardCat === currentFilter;
    });

    const totalPages = Math.ceil(filteredCards.length / postsPerPage);

    // 2. Adjust current page if out of bounds
    if (currentPage > totalPages) {
      currentPage = Math.max(1, totalPages);
    }

    // 3. Hide all cards, then show only the cards for the current page
    postCards.forEach(card => {
      card.style.display = 'none';
    });

    const startIndex = (currentPage - 1) * postsPerPage;
    const endIndex = startIndex + postsPerPage;
    const cardsToDisplay = filteredCards.slice(startIndex, endIndex);

    cardsToDisplay.forEach(card => {
      card.style.display = 'flex';
    });

    // 4. Render pagination controls
    renderPaginationControls(totalPages);
  }

  function renderPaginationControls(totalPages: number) {
    if (!paginationContainer) return;
    paginationContainer.innerHTML = '';

    // If there is only 1 page or no pages, hide pagination controls
    if (totalPages <= 1) {
      return;
    }

    // Previous Button
    const prevBtn = document.createElement('button');
    prevBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    `;
    prevBtn.className = currentPage === 1
      ? 'w-10 h-10 flex items-center justify-center rounded-xl border border-slate-100 text-slate-300 cursor-not-allowed opacity-50'
      : 'w-10 h-10 flex items-center justify-center rounded-xl border-2 border-slate-900 bg-white text-slate-800 hover:bg-slate-50 transition-all cursor-pointer shadow-[2px_2px_0px_#0f172a] active:translate-y-0.5 active:shadow-[0px_0px_0px_#0f172a]';
    
    if (currentPage > 1) {
      prevBtn.addEventListener('click', () => {
        currentPage--;
        updatePagination();
        scrollToBlogTop();
      });
    }
    paginationContainer.appendChild(prevBtn);

    // Page Buttons
    for (let i = 1; i <= totalPages; i++) {
      const pageBtn = document.createElement('button');
      pageBtn.innerText = i.toString();
      pageBtn.className = i === currentPage
        ? 'w-10 h-10 flex items-center justify-center rounded-xl border-2 border-slate-900 bg-blue-650 text-white font-mono font-bold text-xs tracking-wider transition-all cursor-pointer shadow-[3px_3px_0px_#0f172a]'
        : 'w-10 h-10 flex items-center justify-center rounded-xl border-2 border-slate-200 bg-white text-slate-700 hover:border-slate-400 font-mono font-bold text-xs tracking-wider transition-all cursor-pointer';
      
      pageBtn.addEventListener('click', () => {
        currentPage = i;
        updatePagination();
        scrollToBlogTop();
      });
      paginationContainer.appendChild(pageBtn);
    }

    // Next Button
    const nextBtn = document.createElement('button');
    nextBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    `;
    nextBtn.className = currentPage === totalPages
      ? 'w-10 h-10 flex items-center justify-center rounded-xl border border-slate-100 text-slate-300 cursor-not-allowed opacity-50'
      : 'w-10 h-10 flex items-center justify-center rounded-xl border-2 border-slate-900 bg-white text-slate-800 hover:bg-slate-50 transition-all cursor-pointer shadow-[2px_2px_0px_#0f172a] active:translate-y-0.5 active:shadow-[0px_0px_0px_#0f172a]';

    if (currentPage < totalPages) {
      nextBtn.addEventListener('click', () => {
        currentPage++;
        updatePagination();
        scrollToBlogTop();
      });
    }
    paginationContainer.appendChild(nextBtn);
  }

  function scrollToBlogTop() {
    const blogSection = document.getElementById('blog');
    if (blogSection) {
      blogSection.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // Set up filter click events
  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filterValue = tab.getAttribute('data-filter')!;

      // Update active tab styling
      filterTabs.forEach(t => {
        t.classList.remove('bg-slate-955', 'bg-slate-955', 'bg-slate-950', 'text-white', 'shadow-[3px_3px_0px_#2563eb]');
        t.classList.add('bg-white', 'text-slate-955', 'text-slate-950');
      });
      tab.classList.remove('bg-white', 'text-slate-955', 'text-slate-950');
      tab.classList.add('bg-slate-950', 'text-white', 'shadow-[3px_3px_0px_#2563eb]');

      // Reset to page 1 and apply new filter
      currentFilter = filterValue;
      currentPage = 1;
      updatePagination();
    });
  });

  // Run on initial load
  updatePagination();
</script>
