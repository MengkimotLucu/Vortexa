---
import Logo from './Logo.astro';
const lang = Astro.currentLocale === 'en' ? 'en' : 'id';

const content = {
  id: {
    eyebrow: "Studio digital independen",
    headline: "Membangun pengalaman digital yang ikut menumbuhkan bisnis.",
    contactCta: "Mulai proyek bersama kami",
    socialTitle: "Terhubung",
    location: "Bandung, Indonesia / Melayani seluruh Indonesia",
    desc: "Mitra strategis dalam transformasi digital. Kami merancang website berkinerja tinggi dengan sistem otomatisasi AI dan WhatsApp untuk mengamankan pertumbuhan bisnis Anda secara nyata.",
    col1Title: "PEMBUATAN WEBSITE",
    col1: [
      ["Situs Web Profil Perusahaan", "/layanan/web/"],
      ["Landing Page Konversi Tinggi", "/layanan/web/"],
      ["Kustomisasi Web Headless", "/layanan/web/"],
      ["Website Bisnis UMKM", "/layanan/web/"],
      ["Web E-Commerce Cepat", "/layanan/web/"]
    ],
    col2Title: "LAYANAN UTAMA",
    col2: [
      ["Integrasi Agen AI", "/layanan/ai/"],
      ["Mendesain Ulang Situs Web", "/layanan/web/"],
      ["Jasa Technical SEO", "/layanan/seo/"],
      ["Penyuntingan Video Kreatif", "/layanan/video/"],
      ["Keamanan Jaringan", "/layanan/keamanan-jaringan/"],
      ["Audit SEO & Performa (Gratis)", "/audit/"]
    ],
    col3Title: "INFORMASI UMUM",
    col3: [
      ["Tentang Kami", "/tentang/"],
      ["Portofolio", "/portofolio/"],
      ["Karir", "/karir/"],
      ["Blog", "/blog/"],
      ["Website Bandung", "/jasa-pembuatan-website-bandung/"],
      ["Website Jakarta", "/jasa-pembuatan-website-jakarta/"],
      ["Hubungi Kami", "/kontak/"]
    ]
  },
  en: {
    eyebrow: "Independent digital studio",
    headline: "Building digital experiences that move businesses forward.",
    contactCta: "Start a project with us",
    socialTitle: "Connect",
    location: "Bandung, Indonesia / Working worldwide",
    desc: "Strategic partner in digital transformation. We design high-performance websites with AI and WhatsApp automation systems to secure your real business growth.",
    col1Title: "WEBSITE CREATION",
    col1: [
      ["Company Profile Website", "/en/services/web-development/"],
      ["High-Converting Landing Page", "/en/services/web-development/"],
      ["Headless Web Customization", "/en/services/web-development/"],
      ["SME Business Website", "/en/services/web-development/"],
      ["Fast E-Commerce Web", "/en/services/web-development/"]
    ],
    col2Title: "CORE SERVICES",
    col2: [
      ["AI Agent Integration", "/en/services/ai-automation/"],
      ["Website Redesign", "/en/services/web-development/"],
      ["Technical SEO Service", "/en/services/seo/"],
      ["Creative Video Editing", "/en/services/video-production/"],
      ["Network Security", "/en/services/network-security/"],
      ["Free SEO & Speed Audit", "/en/audit/"]
    ],
    col3Title: "GENERAL INFO",
    col3: [
      ["About Us", "/en/about-us/"],
      ["Portfolio", "/en/portfolio/"],
      ["Careers", "/en/careers/"],
      ["Blog", "/en/blog/"],
      ["Contact Us", "/en/contact/"]
    ]
  }
}[lang];

// For brand link
const homeLink = lang === 'en' ? '/en/' : '/';
const privacyLink = lang === 'en' ? '/en/privacy-policy/' : '/privacy-policy/';
const termsLink = lang === 'en' ? '/en/terms-of-service/' : '/terms-of-service/';
const contactLink = lang === 'en' ? '/en/contact/' : '/kontak/';
const navColumns: { title: string; links: string[][] }[] = [
  { title: content.col1Title, links: content.col1 },
  { title: content.col2Title, links: content.col2 },
  { title: content.col3Title, links: content.col3 }
];
---
<footer class="footer-shell relative mt-12 overflow-hidden bg-[#171512] text-[#d8d1c5]">
  <div class="footer-accent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 pb-8 pt-16 sm:px-8 sm:pt-20 lg:px-10 lg:pt-24">
    <div class="grid gap-12 border-b border-[#f7f4ef]/15 pb-14 lg:grid-cols-12 lg:gap-8 lg:pb-20">
      <div class="lg:col-span-7">
        <a href={homeLink} class="footer-brand group inline-flex min-h-12 items-center gap-3 text-[#f7f4ef]">
          <Logo class="h-8 w-8 transition-transform duration-300 group-hover:translate-x-1" />
          <span class="font-display text-2xl font-black tracking-widest sm:text-3xl">LUMOVELO</span>
        </a>
        <p class="mt-8 max-w-3xl font-display text-3xl font-black leading-[1.12] text-[#f7f4ef] sm:text-5xl lg:text-6xl">
          {content.headline}
        </p>
      </div>

      <div class="flex flex-col justify-between gap-10 lg:col-span-4 lg:col-start-9 lg:pt-1">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-[#8faeff]">{content.eyebrow}</p>
          <p class="mt-4 max-w-md text-sm font-medium leading-7 text-[#c9c1b4]">{content.desc}</p>
        </div>
        <a href={contactLink} class="footer-cta group flex min-h-14 items-center justify-between border-b border-[#f7f4ef]/40 py-3 text-base font-bold text-[#f7f4ef] transition-colors duration-300 hover:border-[#8faeff] hover:text-[#8faeff]">
          <span>{content.contactCta}</span>
          <span class="text-2xl leading-none transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>

    <div class="grid gap-12 py-14 md:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-16">
      <div class="lg:col-span-3">
        <p class="text-xs font-bold uppercase tracking-widest text-[#8faeff]">{content.socialTitle}</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-[#f7f4ef]">
          <a href="https://www.instagram.com/lumoveloagency?igsh=ZHN1cDJmeDRnZDVw&utm_source=qr" target="_blank" rel="noopener noreferrer" class="footer-link">Instagram</a>
          <a href="https://www.linkedin.com/in/lumovelo/" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
          <a href="https://x.com/lumovelo" target="_blank" rel="noopener noreferrer" class="footer-link">X</a>
          <a href="https://www.facebook.com/share/1DEVhTihYb/" target="_blank" rel="noopener noreferrer" class="footer-link">Facebook</a>
        </div>
        <p class="mt-8 max-w-xs text-xs font-medium leading-6 text-[#948c80]">{content.location}</p>
      </div>

      {navColumns.map(({ title, links }) => (
        <div class="lg:col-span-3">
          <h4 class="border-t border-[#f7f4ef]/20 pt-4 text-xs font-bold uppercase tracking-widest text-[#f7f4ef]">{title}</h4>
          <ul class="mt-4">
            {links.map(([text, href]) => (
              <li>
                <a href={href} class="footer-nav-link flex min-h-11 items-center text-sm font-medium leading-5 text-[#bdb6a9] transition-colors duration-200 hover:text-[#f7f4ef]">
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col gap-5 border-t border-[#f7f4ef]/15 pt-7 text-[10px] font-bold uppercase tracking-widest text-[#948c80] sm:flex-row sm:items-center sm:justify-between">
      <p>(c) {new Date().getFullYear()} LUMOVELO. Developed for measurable growth.</p>
      <div class="flex flex-wrap gap-x-7 gap-y-2">
        <a href={privacyLink} class="footer-link">Privacy Policy</a>
        <a href={termsLink} class="footer-link">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-shell {
    border-radius: 3rem 3rem 0 0;
  }

  .footer-accent {
    position: absolute;
    inset: 0 auto auto 0;
    width: min(38rem, 68vw);
    height: 0.3rem;
    background: #4f7cff;
    transform: skewX(-36deg) translateX(-2rem);
    transform-origin: left center;
  }

  .footer-link,
  .footer-nav-link,
  .footer-brand,
  .footer-cta {
    outline: none;
  }

  .footer-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    transition: color 200ms ease;
  }

  .footer-link:hover {
    color: #f7f4ef;
  }

  .footer-link:focus-visible,
  .footer-nav-link:focus-visible,
  .footer-brand:focus-visible,
  .footer-cta:focus-visible {
    border-radius: 0.25rem;
    box-shadow: 0 0 0 3px #171512, 0 0 0 5px #8faeff;
  }

  @media (max-width: 639px) {
    .footer-shell {
      border-radius: 2rem 2rem 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-shell * {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
